{
    # Enable FrankenPHP
    frankenphp
    # Enable HTTP/3 support
    servers {
        protocols h1 h2 h3
    }
}

:80 {
    # Redirect HTTP to HTTPS
    redir https://{host}{uri} permanent
}

:443 {
    # SSL configuration
    tls /app/ssl/localhost.crt /app/ssl/localhost.key
    
    # Set the root directory
    root * /app/public

    # Handle static files first
    @static {
        file
        path *.css *.js *.ico *.png *.jpg *.jpeg *.gif *.svg *.woff *.woff2 *.ttf *.eot
    }
    handle @static {
        header Cache-Control "public, max-age=31536000"
        file_server
    }

    # Handle build assets with long cache
    handle /build/* {
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # Handle API routes with PHP
    handle /api/* {
        php {
            root /app/public
        }
    }

    # Handle all other requests with SPA fallback
    handle {
        try_files {path} /index.php
        php {
            root /app/public
        }
    }

    # Logging
    log {
        output stdout
        format console
    }
}
