<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}LEARN-FAIR Lesson Plan Editor{% endblock %}</title>

        {% block stylesheets %}
            {% if app.environment == 'dev' %}
                {{ vite_entry_link_tags('app') }}
            {% else %}
                <link rel="stylesheet" href="{{ versioned_asset('/build/assets/app.css') }}">
            {% endif %}
        {% endblock %}

        {% block javascripts %}
            {% if app.environment == 'dev' %}
                {{ vite_entry_script_tags('app') }}
            {% else %}
                <script type="module" src="{{ versioned_asset('/build/assets/app.js') }}" defer></script>
            {% endif %}
        {% endblock %}
    </head>
    <body>
        <div id="root"></div>
    </body>
</html>
